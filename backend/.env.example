# Copia in .env e personalizza
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*

# Postgres in produzione (Railway/Render). Se assente: SQLite locale.
# DATABASE_URL=postgres://user:pass@host:5432/youty

# CORS (produzione): origini dei due frontend, separate da virgola
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://app.example.com

# JWT (default: usa SECRET_KEY)
# JWT_SECRET=

# Stripe — se assenti, gli endpoint di pagamento rispondono 503
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Yourang — outbox WhatsApp/automazioni (API non ancora disponibili)
# YOURANG_API_URL=
# YOURANG_API_KEY=

# Yourang — tutto passa dal proxy (connect.<brand>). Il portale NON possiede
# credenziali Yourang: niente client_id/secret, niente token, niente cifratura.
# I due segreti qui sotto sono verso il proxy, e li genera chi lo amministra
# (deploy/.env.proxy: PROXY_BEAUTY_API_KEY / PROXY_BEAUTY_OUT_SECRET).
# YOURANG_PROXY_URL=https://connect.yourang.ai
# YOURANG_PROXY_SLUG=beauty
# YOURANG_PROXY_API_KEY=
# YOURANG_PROXY_WEBHOOK_SECRET=
# FRONTEND_ORIGIN=http://localhost:5173
